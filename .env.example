# 8004skill environment variables
# Copy this file to ~/.8004skill/.env and fill in the values you need.
# Shell environment variables take precedence over values defined here.
#
#   cp .env.example ~/.8004skill/.env
#   chmod 600 ~/.8004skill/.env

# ── IPFS provider (choose ONE for register/update operations) ─────
# If not set here, the agent will prompt for the credential inline each time.
# PINATA_JWT=            # JWT from pinata.cloud (sensitive — never commit)
# FILECOIN_PRIVATE_KEY=  # Filecoin pinning key (sensitive — never commit)
# IPFS_NODE_URL=         # Local IPFS node URL (e.g. http://127.0.0.1:5001)

# ── Signing (choose ONE — WalletConnect or PRIVATE_KEY) ────────
# WC_PROJECT_ID=         # Optional — a default project ID is provided.
#                        # Get your own at cloud.walletconnect.com for
#                        # higher rate limits and usage analytics.
# PRIVATE_KEY=           # Hex private key for headless signing (sensitive — never commit).
#                        # Alternative to WalletConnect for automated/server-side flows.
#                        # Used for x402 payments and write operations when WC is unavailable.

# ── Per-chain RPC overrides (SDK 1.7.0+) ─────────────────────
# Override the built-in default RPC URL for a specific chain.
# Format: OVERRIDE_RPC_{chainId}=<url>
# OVERRIDE_RPC_84532=https://base-sepolia.drpc.org
# OVERRIDE_RPC_8453=https://your-private-base-rpc.example.com

# ── Non-default chains (only needed for chains without built-in support) ───
# SUBGRAPH_URL=                    # Subgraph URL for the target chain
# REGISTRY_ADDRESS_IDENTITY=       # Identity registry contract address
# REGISTRY_ADDRESS_REPUTATION=     # Reputation registry contract address

# ── Optional overrides ───────────────────────────────────────────
# DEBUG=1                # Enable verbose stack traces
